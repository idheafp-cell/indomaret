{
  "info": {
    "name": "Dashboard Indomaret - API",
    "description": "Koleksi Postman untuk backend Laravel Dashboard Indomaret. Skema data (nama tabel/kolom/endpoint) sudah dalam Bahasa Inggris; teks pesan error & label tetap Bahasa Indonesia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api" },
    { "key": "token", "value": "" },
    { "key": "regency_id", "value": "1" },
    { "key": "store_id", "value": "1" },
    { "key": "item_category_id", "value": "1" },
    { "key": "employee_id", "value": "1" },
    { "key": "user_id", "value": "1" },
    { "key": "expense_id", "value": "1" },
    { "key": "income_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@indomaret-dashboard.test\",\n  \"password\": \"password123\",\n  \"device_name\": \"postman\"\n}"
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/me"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"password123\",\n  \"new_password\": \"password456\",\n  \"new_password_confirmation\": \"password456\"\n}"
            },
            "url": "{{base_url}}/me/password"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/logout"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/notifications?unread_only=0&per_page=15"
          }
        },
        {
          "name": "Mark One Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/notifications/1/read"
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Dashboard & Stores Map",
      "item": [
        {
          "name": "Dashboard Summary (manager)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/dashboard?start_date=2026-09-01&end_date=2026-09-30"
          }
        },
        {
          "name": "Stores Map (peta sebaran)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/stores/map"
          }
        },
        {
          "name": "Store Map Summary (isi popup peta)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/stores/{{store_id}}/map-summary"
          }
        }
      ]
    },
    {
      "name": "Master - Regencies (manager)",
      "item": [
        {
          "name": "List Regencies",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/regencies" }
        },
        {
          "name": "Create Regency",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Kabupaten Sidoarjo\",\n  \"province\": \"Jawa Timur\"\n}" },
            "url": "{{base_url}}/regencies"
          }
        },
        {
          "name": "Update Regency",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Kota Surabaya\",\n  \"province\": \"Jawa Timur\"\n}" },
            "url": "{{base_url}}/regencies/{{regency_id}}"
          }
        },
        {
          "name": "Delete Regency",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/regencies/{{regency_id}}"
          }
        }
      ]
    },
    {
      "name": "Master - Stores",
      "item": [
        {
          "name": "List Stores (manager, supervisor)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/stores" }
        },
        {
          "name": "Show Store",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/stores/{{store_id}}" }
        },
        {
          "name": "Create Store (manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"regency_id\": {{regency_id}},\n  \"store_code\": \"IDM-SBY-260\",\n  \"name\": \"Indomaret Baru\",\n  \"address\": \"Jl. Contoh No. 1\",\n  \"district\": \"Gubeng\",\n  \"latitude\": -7.2650,\n  \"longitude\": 112.7520,\n  \"phone\": \"031-8945123\",\n  \"photo_url\": null\n}"
            },
            "url": "{{base_url}}/stores"
          }
        },
        {
          "name": "Update Store (manager)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"031-8945999\",\n  \"is_active\": true\n}" },
            "url": "{{base_url}}/stores/{{store_id}}"
          }
        },
        {
          "name": "Delete Store (manager)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/stores/{{store_id}}"
          }
        }
      ]
    },
    {
      "name": "Master - Item Categories",
      "item": [
        {
          "name": "List Item Categories",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/item-categories?active_only=1" }
        },
        {
          "name": "Create Item Category (manager)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Minuman\",\n  \"description\": \"Minuman kemasan & botol\"\n}" },
            "url": "{{base_url}}/item-categories"
          }
        },
        {
          "name": "Update Item Category (manager)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" },
            "url": "{{base_url}}/item-categories/{{item_category_id}}"
          }
        },
        {
          "name": "Delete Item Category (manager)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/item-categories/{{item_category_id}}"
          }
        }
      ]
    },
    {
      "name": "Accounts - Users (manager)",
      "item": [
        {
          "name": "List Users",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/users?role=supervisor" }
        },
        {
          "name": "Create Supervisor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Supervisor Baru\",\n  \"email\": \"supervisor.baru@indomaret-dashboard.test\",\n  \"password\": \"password123\",\n  \"role\": \"supervisor\",\n  \"store_id\": {{store_id}}\n}"
            },
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Create Cashier Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kasir Toko\",\n  \"email\": \"kasir.baru@indomaret-dashboard.test\",\n  \"password\": \"password123\",\n  \"role\": \"cashier\",\n  \"store_id\": {{store_id}}\n}"
            },
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" },
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/users/{{user_id}}"
          }
        }
      ]
    },
    {
      "name": "Employees (manager, supervisor)",
      "item": [
        {
          "name": "List Employees",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/employees" }
        },
        {
          "name": "Create Employee (supervisor - store implicit)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Kasir Tiga\",\n  \"password\": \"kasir123\"\n}" },
            "url": "{{base_url}}/employees"
          }
        },
        {
          "name": "Create Employee (manager - store_id wajib)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"store_id\": {{store_id}},\n  \"name\": \"Kasir Tiga\",\n  \"password\": \"kasir123\"\n}" },
            "url": "{{base_url}}/employees"
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": false\n}" },
            "url": "{{base_url}}/employees/{{employee_id}}"
          }
        },
        {
          "name": "Delete Employee",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/employees/{{employee_id}}"
          }
        }
      ]
    },
    {
      "name": "Expenses (Barang Keluar)",
      "item": [
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/expenses?start_date=2026-09-01&end_date=2026-09-30&status=approved&search="
          }
        },
        {
          "name": "Show Expense",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/expenses/{{expense_id}}" }
        },
        {
          "name": "Create Expense (manager/supervisor sendiri)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_category_id\": {{item_category_id}},\n  \"date\": \"2026-09-15\",\n  \"quantity\": 20,\n  \"unit\": \"pcs\",\n  \"value\": 250000,\n  \"notes\": \"Stok opname harian\"\n}"
            },
            "url": "{{base_url}}/expenses"
          }
        },
        {
          "name": "Create Expense (akun cashier - butuh nama & password karyawan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_category_id\": {{item_category_id}},\n  \"date\": \"2026-09-15\",\n  \"quantity\": 10,\n  \"value\": 120000,\n  \"employee_name\": \"Kasir Satu\",\n  \"employee_password\": \"kasir123\"\n}"
            },
            "url": "{{base_url}}/expenses"
          }
        },
        {
          "name": "Update Expense (manager, supervisor)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 25,\n  \"value\": 300000\n}" },
            "url": "{{base_url}}/expenses/{{expense_id}}"
          }
        },
        {
          "name": "Delete Expense (manager, supervisor)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/expenses/{{expense_id}}"
          }
        },
        {
          "name": "Approve Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/expenses/{{expense_id}}/approve"
          }
        },
        {
          "name": "Reject Expense",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rejection_reason\": \"Nilai tidak sesuai nota, mohon input ulang.\"\n}" },
            "url": "{{base_url}}/expenses/{{expense_id}}/reject"
          }
        }
      ]
    },
    {
      "name": "Incomes (Pemasukan)",
      "item": [
        {
          "name": "List Incomes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/incomes?start_date=2026-09-01&end_date=2026-09-30&status=approved&search="
          }
        },
        {
          "name": "Show Income",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{base_url}}/incomes/{{income_id}}" }
        },
        {
          "name": "Create Income (manager/supervisor sendiri)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"date\": \"2026-09-15\",\n  \"amount\": 3500000,\n  \"notes\": \"Setoran kasir shift pagi\"\n}" },
            "url": "{{base_url}}/incomes"
          }
        },
        {
          "name": "Create Income (akun cashier - butuh nama & password karyawan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-09-15\",\n  \"amount\": 3500000,\n  \"employee_name\": \"Kasir Satu\",\n  \"employee_password\": \"kasir123\"\n}"
            },
            "url": "{{base_url}}/incomes"
          }
        },
        {
          "name": "Update Income (manager, supervisor)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 4000000\n}" },
            "url": "{{base_url}}/incomes/{{income_id}}"
          }
        },
        {
          "name": "Delete Income (manager, supervisor)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/incomes/{{income_id}}"
          }
        },
        {
          "name": "Approve Income",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/incomes/{{income_id}}/approve"
          }
        },
        {
          "name": "Reject Income",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rejection_reason\": \"Nominal tidak sesuai setoran fisik.\"\n}" },
            "url": "{{base_url}}/incomes/{{income_id}}/reject"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Download PDF Expenses & Incomes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/reports/expenses-incomes/pdf?store_id={{store_id}}&start_date=2026-09-01&end_date=2026-09-30"
          }
        }
      ]
    }
  ]
}
